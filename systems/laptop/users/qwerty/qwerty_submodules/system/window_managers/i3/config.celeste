#
#
# Celeste i3 theme made by Qw3rty26

# Font for i3
font pango:Monocraft 10

# Window borders
new_window pixel 1
new_float pixel 1

# Colors
client.focused          #FF2D55 #1D1F21 #FF2D55 #E0E0E0
client.focused_inactive #9B5DE5 #1D1F21 #9B5DE5 #E0E0E0
client.unfocused        #1D1F21 #1D1F21 #1D1F21 #E0E0E0
client.urgent           #FFD166 #1D1F21 #FFD166 #E0E0E0

# Gaps
gaps inner 5
gaps outer 5

#Variable configs
set $mod Mod4


#On-Startup Configs
exec_always --no-startup-id i3-msg reload

# picks a random wallpaper
exec_always --no-startup-id sh -c 'feh --no-fehbg --bg-scale "$(find -L $HOME/.config/i3/wallpapers/ -type f | shuf -n1)"'

#Start compositor daemon picom
exec_always --no-startup-id picom --daemon 

#Set floating windows max size
floating_maximum_size 1920 x 1080
floating_minimum_size -1 x -1

#Align title of window to center
title_align center

#Enable Back and Forth Workspaces
workspace_auto_back_and_forth yes

#Setting up the bar
bar {
	mode hide
	status_command i3status
}

#Shortcuts configs
bindsym $mod+b bar mode toggle
bindsym $mod+Return exec kitty
bindsym $mod+f exec --no-startup-id firefox
bindsym Control+q kill


#set $wallpaper /home/Qw3rty26/Documents/Qw3rty26/images/celeste_sprites/wallpapers/

#bindsym $mod+1 exec --no-startup-id feh --bg-scale /home/Qw3rty26/Gallery/Celeste1.png; workspace number $ws1
