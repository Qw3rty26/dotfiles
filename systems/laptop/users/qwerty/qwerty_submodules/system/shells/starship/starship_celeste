[character]
success_symbol = "✓"
error_symbol   = "✗"
vicmd_symbol   = "❮"
format         = "$symbol "

[username]
style_user = "bold fg:#FF5DA3"
show_always = true
format = "[$user]($style_user)@"

[hostname]
ssh_only = false
style = "bold fg:#4EC9DE"
format = "[$hostname]($style) "

[directory]
style = "fg:#1E90FF"
read_only = " 🔒"

[git_branch]
symbol = "⎇ "
style = "fg:#FF71CE"

[git_state]
style = "bold fg:#FFD166"

[git_status]
staged      = "[+](fg:#FFD166)"
modified    = "[~](fg:#FF5DA3)"
deleted     = "[−](fg:#FF1C1C)"
renamed     = "[→](fg:#4EC9DE)"
untracked   = "[?](fg:#4EC9DE)"
conflicted  = "[!](fg:#FF2D55)"
stashed     = "[💾](fg:#FFD166)"
ahead       = "⇡"
behind      = "⇣"
up_to_date  = "="

[package]
symbol = "💾 "
style  = "fg:#FFD166"
disabled = false

[time]
disabled = true

[battery]
disabled = true
